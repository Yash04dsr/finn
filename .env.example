# Root env — used by backend (uv) and frontend (Next.js)
# OpenAI-compatible gateway
HYDE_API_KEY=your-key-here
HYDE_BASE_URL=https://inference.hyde.tech/v1

# Model routing (fast tier + reasoning tier; swap via env without code changes)
FINN_MODEL_FAST=hyde/glm-5.3-flash
FINN_MODEL_REASONING=hyde/glm-5.3-flash

# Optional token pricing in USD per 1M tokens (if unset, answer cost is omitted rather than guessed)
# FINN_PRICE_FAST_IN=0.0
# FINN_PRICE_FAST_OUT=0.0
# FINN_PRICE_REASONING_IN=0.0
# FINN_PRICE_REASONING_OUT=0.0

# Frontend (/api/* rewrite target in frontend/next.config.ts)
FINN_BACKEND_URL=http://localhost:8000
