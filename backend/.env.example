# OpenAI-compatible gateway (required)
HYDE_API_KEY=your-key-here
HYDE_BASE_URL=https://inference.hyde.tech/v1

# Model routing — FINN separates fast vs reasoning tiers so a stronger model
# can be dropped in for analysis without code changes.
FINN_MODEL_FAST=hyde/glm-5.3-flash
FINN_MODEL_REASONING=hyde/glm-5.3-flash

# Public demo boundaries
FINN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FINN_CHAT_RATE_PER_MINUTE=20
FINN_MUTATION_RATE_PER_MINUTE=10
FINN_DEMO_RUN_RATE_PER_HOUR=2
